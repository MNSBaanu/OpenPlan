{
  "name": "OpenPlan",
  "short_name": "OpenPlan",
  "description": "Free, browser-based project planner",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#1e1b4b",
  "background_color": "#ffffff",
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/openplan-mark.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/x-openplan": [".openplan"] },
      "icons": [{ "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ]
}
